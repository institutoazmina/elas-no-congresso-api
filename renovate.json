{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["* 0-5 * * 1"],
  "minimumReleaseAge": "3 days",
  "enabledManagers": ["pep621", "npm", "github-actions", "dockerfile", "docker-compose"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "automerge": false,
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 1,
    "dependencyDashboardApproval": true,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Group routine Python updates; isolate Django and ML below.",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "Python routine dependencies"
    },
    {
      "description": "Keep email build dependencies in their own PR.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "email build dependencies"
    },
    {
      "description": "Maintain immutable action references together.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group container updates across Dockerfiles, Compose and CI services.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "container images"
    },
    {
      "description": "Major upgrades require dashboard approval and individual PRs.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": null
    },
    {
      "description": "Review framework upgrades separately from other Python changes.",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["django"],
      "groupName": null,
      "prBodyNotes": ["Review Django release notes and migrations before merging."]
    },
    {
      "description": "Review PyTorch and Transformers together, including minor upgrades.",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["torch", "transformers"],
      "groupName": "Quiteria ML runtime",
      "separateMajorMinor": false,
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "Require the Quiteria model compatibility job; review any drift from the pre-upgrade inference baseline.",
        "Regenerate uv.lock using the configured PyTorch CPU index and retain Linux CPU wheels."
      ]
    }
  ]
}
