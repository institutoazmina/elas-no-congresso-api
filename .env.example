DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-changeme-for-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=elas
POSTGRES_USER=elas
POSTGRES_PASSWORD=elas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_SES_ENDPOINT_URL=
AWS_SES_FROM_EMAIL=alertas@elasnocongresso.local

# Imagens de compartilhamento das parlamentares (bucket S3 do site)
OG_S3_BUCKET=
OG_AWS_ENDPOINT_URL=

# Public base URL used to build links inside outgoing emails
SITE_BASE_URL=http://localhost:8000

# Site estático (outro domínio): destino do redirect depois de confirmar ou
# cancelar a inscrição, e origem liberada no CORS do modal de alertas.
PUBLIC_SITE_URL=http://localhost:4321
CORS_ALLOWED_ORIGINS=https://www.elasnocongresso.com.br,https://elasnocongresso.com.br,https://homologacao.elasnocongresso.com.br,http://localhost:4321

# Teto de inscrições por IP/hora. O POST é aberto e cada inscrição custa um
# e-mail de confirmação no SES.
SUBSCRIPTION_THROTTLE_RATE_PER_HOUR=10

# Resumo diário: um e-mail por endereço, no horário de America/Sao_Paulo (HH:MM).
# Use o mesmo valor no beat e nos workers; reinicie ambos após alterar.
DAILY_DIGEST_TIME=09:00

# Weekly Substack Radar: Monday draft by 07:00 America/Sao_Paulo.
# Enable only after validating an unpublished draft (see docs/newsletter.md).
WEEKLY_NEWSLETTER_ENABLED=False
WEEKLY_NEWSLETTER_BATCH_SIZE=5
SUBSTACK_PUBLICATION_URL=https://elasnocongresso.substack.com
# Full browser Cookie header. Treat as a secret; renew after session expiration.
SUBSTACK_COOKIES_STRING=

# Admin path (move off the obvious /admin/ in prod; keep trailing slash)
ADMIN_URL=admin/

# Explorer structured timing logs: 0 disabled, 0.1 samples 10%, 1 all requests
ACTIVITY_EXPLORER_TRACE_SAMPLE_RATE=0
