<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" color="#373732" />
      <mj-text font-size="16px" line-height="1.35" padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body>
    <mj-section padding="0">
      <mj-column padding="0">
        <mj-image
          src="{{ confirmation_header_url }}"
          alt="Elas no Congresso — Instituto AzMina"
          width="600px"
          padding="0"
        />
      </mj-column>
    </mj-section>

    <mj-section padding="64px 56px 0">
      <mj-column padding="0">
        <mj-text font-size="18px" font-weight="700" line-height="1.2">Olá,</mj-text>

        <mj-text font-size="18px" line-height="1.3" padding="32px 0 0">
          Falta só um passo para ativar seus alertas do Elas no Congresso.
        </mj-text>

        <mj-text font-size="16px" line-height="1.35" padding="24px 0 0">
          Ao confirmar sua inscrição, você passa a receber atualizações das proposições e temas que escolheu acompanhar.
        </mj-text>

        <mj-button
          href="{{ link_confirmacao }}"
          background-color="#1E2546"
          border-radius="10px"
          color="#FFFFFF"
          font-size="16px"
          inner-padding="14px 28px"
          padding="36px 0 0"
        >
          Confirmar inscrição
        </mj-button>

        <mj-text font-size="14px" line-height="1.35" padding="30px 0 0">
          Este link é válido por 48 horas. Se você não pediu estes alertas, pode ignorar este e-mail.
        </mj-text>

        <mj-text font-size="16px" line-height="1.3" padding="48px 0 0">
          Até breve,<br />
          <strong>Elas no Congresso</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="56px 56px 64px">
      <mj-column padding="0">
        <mj-divider border-color="#1E2546" border-width="1px" padding="0" />
        <mj-text align="center" color="#1E2546" font-size="14px" line-height="1.2" padding="24px 0 0">
          Elas no Congresso&nbsp; {{ ano }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
